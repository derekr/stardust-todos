{
  "name": "todo-stardust",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A todo app backed by Stardust \u2014 with a CLI and a Datastar web UI, both live via reactor SSE.",
  "scripts": {
    "web": "node src/server.ts",
    "cli": "node src/cli.ts",
    "seed": "node src/seed-demo.ts",
    "stardust:setup": "node scripts/setup.ts",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint --fix src scripts",
    "test": "node --test 'src/**/*.test.ts'",
    "check": "oxfmt --check src scripts && oxlint src scripts && tsgo --noEmit && knip && node --test 'src/**/*.test.ts'",
    "typecheck": "tsgo --noEmit",
    "gen:query": "node scripts/gen-query.ts",
    "knip": "knip",
    "stress": "node scripts/stress/run.ts"
  },
  "dependencies": {
    "@starfederation/datastar-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "^6.29.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0"
  }
}
